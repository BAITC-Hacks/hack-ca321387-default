# Server-only variables. Defaults work from the repository root.
AI_SERVICE_URL=http://localhost:8100
AI_TIMEOUT_SECONDS=2
SEMANTIC_MODE=tfidf
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional server-only OpenAI key for AI-written explanations. Never use VITE_ here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=8
# auto: OpenAI when a key exists, otherwise template. local: Hugging Face,
# then OpenAI (if configured), then template. openai/template are explicit modes.
EXPLANATION_MODE=auto
LOCAL_EXPLANATION_TIMEOUT_SECONDS=30
LOCAL_HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# Optional: absolute path to a CSV using the supplied dataset schema.
# DATASET_PATH=/absolute/path/to/catalog.csv
