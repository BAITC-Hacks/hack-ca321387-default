FROM python:3.12-slim

WORKDIR /app

# CPU-only PyTorch keeps the optional image smaller than a CUDA build.
RUN pip install --no-cache-dir "torch>=2.4,<3" --index-url https://download.pytorch.org/whl/cpu
COPY requirements.txt requirements-local.txt ./
RUN pip install --no-cache-dir -r requirements-local.txt

COPY app ./app

EXPOSE 8200
CMD ["uvicorn", "app.local_explainer:app", "--host", "0.0.0.0", "--port", "8200"]
