# Server only. Load explicitly with uvicorn --env-file backend/.env.
AI_SERVICE_URL=http://localhost:8100
AI_TIMEOUT_SECONDS=2
SEMANTIC_MODE=tfidf
# Debug route is absent (404, including OpenAPI) unless explicitly enabled.
ENABLE_MATCH_TRACE=false
# Optional existing settings:
# DATASET_PATH=/absolute/path/to/catalog.csv
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
